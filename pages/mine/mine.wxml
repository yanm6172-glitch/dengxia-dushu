<view class="page">
  <view class="user-card">
    <block wx:if="{{loggedIn}}">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image class="avatar" src="{{avatar || '/assets/avatar_default.png'}}" mode="aspectFill" />
      </button>
      <view class="user-info">
        <input type="nickname" class="nickname" value="{{nickname}}" placeholder="点击设置昵称" bindblur="onNicknameBlur" maxlength="20" />
        <view class="uid">ID {{openidShort}} · {{syncText}}</view>
      </view>
      <view class="logout-btn" bindtap="doLogout">退出</view>
    </block>
    <block wx:else>
      <view class="avatar avatar-ph">未</view>
      <view class="user-info">
        <view class="nickname-guest">未登录</view>
        <view class="uid">登录后同步阅读数据（生产环境）</view>
      </view>
      <view class="login-btn" bindtap="goLogin">微信登录</view>
    </block>
  </view>

  <view class="stats-card">
    <view class="stats-row">
      <view class="stat">
        <view class="num">{{totalHours}}</view>
        <view class="label">累计(小时)</view>
      </view>
      <view class="stat">
        <view class="num">{{totalDays}}</view>
        <view class="label">阅读天数</view>
      </view>
      <view class="stat">
        <view class="num">{{streak}}</view>
        <view class="label">连续天数</view>
      </view>
      <view class="stat">
        <view class="num">{{todayMinutes}}</view>
        <view class="label">今日(分钟)</view>
      </view>
    </view>
    <view class="chart-title">近 7 天阅读时长（分钟）</view>
    <view class="chart">
      <view class="bar" wx:for="{{last7}}" wx:key="index">
        <view class="bar-min">{{item.minutes}}</view>
        <view class="bar-inner" style="height:{{item.h}}px"></view>
        <view class="bar-label">{{item.label}}</view>
      </view>
    </view>
  </view>

  <view class="cal-card">
    <view class="cal-title">{{monthLabel}} · 读满 1 分钟点亮一天</view>
    <view class="cal-grid">
      <view class="cal-cell" wx:for="{{calendar}}" wx:key="index">
        <view class="cal-day {{item.on ? 'on' : ''}}">{{item.d}}</view>
      </view>
    </view>
  </view>

  <button class="btn-main" bindtap="goImport">＋ 导入自己的书籍</button>
  <button class="btn-report" bindtap="makeReport">📜 生成阅读报告 · 分享</button>
  <view class="setting-row" bindtap="toggleRemind">
    <view class="setting-label">每日阅读提醒</view>
    <view class="setting-right">{{remind ? '已开启' : '未开启'}} ›</view>
  </view>
  <view class="notes-card" bindtap="openNotesSheet">
    <view class="marks-head">
      <view class="setting-label">我的笔记（{{notesTotal}}）</view>
      <view class="setting-right">{{notesTotal > 0 ? '查看全部 ›' : '长按段落选「写笔记」 ›'}}</view>
    </view>
    <view class="marks-item" wx:for="{{notesPreview}}" wx:key="idx">
      <view class="marks-src">《{{item.bookTitle}}》 {{item.text}}</view>
      <view class="marks-text">心得：{{item.note}}</view>
    </view>
  </view>

  <view class="marks-card" bindtap="openMarksSheet">
    <view class="marks-head">
      <view class="setting-label">我的摘抄（{{marksTotal}}）</view>
      <view class="setting-right">{{marksTotal > 0 ? '查看全部 ›' : '长按正文可添加书签 ›'}}</view>
    </view>
    <view class="marks-item" wx:for="{{marksPreview}}" wx:key="idx">
      <view class="marks-src">《{{item.bookTitle}}》</view>
      <view class="marks-text">{{item.text}}</view>
    </view>
  </view>

  <view class="heat-card">
    <view class="heat-title">年度足迹 · 近 26 周</view>
    <view class="heat-grid">
      <view class="heat-col" wx:for="{{heatmap}}" wx:for-item="col" wx:key="index">
        <view class="heat-cell {{cell.level > 0 ? 'l' + cell.level : ''}} {{cell.today ? 'today' : ''}}" wx:for="{{col}}" wx:for-item="cell" wx:key="k"></view>
      </view>
    </view>
    <view class="heat-legend">
      <text>少</text>
      <view class="hl h0"></view>
      <view class="hl h1"></view>
      <view class="hl h2"></view>
      <view class="hl h3"></view>
      <text>多</text>
    </view>
  </view>

  <view class="goal-row">
    <view class="setting-label">每日阅读目标</view>
    <view class="goal-chips">
      <text class="goal-chip {{goalMinutes === 15 ? 'on' : ''}}" data-g="15" bindtap="setGoal">15</text>
      <text class="goal-chip {{goalMinutes === 25 ? 'on' : ''}}" data-g="25" bindtap="setGoal">25</text>
      <text class="goal-chip {{goalMinutes === 30 ? 'on' : ''}}" data-g="30" bindtap="setGoal">30</text>
      <text class="goal-chip {{goalMinutes === 45 ? 'on' : ''}}" data-g="45" bindtap="setGoal">45</text>
      <text class="goal-unit">分钟</text>
    </view>
  </view>
  <view class="goal-row" bindtap="doBackup">
    <view class="setting-label">备份数据</view>
    <view class="setting-right">复制到剪贴板 ›</view>
  </view>

  <view class="section-title">我的书籍（{{customBooks.length}}）</view>
  <view class="empty" wx:if="{{customBooks.length === 0}}">还没有自藏书。点上方按钮，从微信文件或粘贴文本导入。</view>
  <view class="my-book" wx:for="{{customBooks}}" wx:key="id" data-id="{{item.id}}" bindtap="openBook">
    <view class="my-book-info">
      <view class="mb-title">{{item.title}}</view>
      <view class="mb-sub">{{item.author}} · {{item.type}}</view>
    </view>
    <view class="mb-del" data-id="{{item.id}}" catchtap="deleteBook">删除</view>
  </view>

  <view class="about">灯下读书 v4 · 书库为公版古籍 · 自藏书仅存本机</view>

  <!-- 摘抄面板 -->
  <view class="mask" wx:if="{{showMarks}}" bindtap="closeMarksSheet"></view>
  <view class="marks-sheet" wx:if="{{showMarks}}">
    <view class="sheet-title">全部摘抄（{{allMarks.length}}）</view>
    <scroll-view scroll-y class="sheet-list">
      <view class="marks-item" wx:for="{{allMarks}}" wx:key="idx">
        <view class="marks-src">《{{item.bookTitle}}》</view>
        <view class="marks-text">{{item.text}}</view>
      </view>
      <view class="sheet-empty" wx:if="{{allMarks.length === 0}}">还没有摘抄，去阅读页长按喜欢的段落添加书签</view>
    </scroll-view>
    <button class="btn-copy" bindtap="copyMarks" disabled="{{allMarks.length === 0}}">复制全部摘抄</button>
  </view>

  <!-- 笔记面板 -->
  <view class="mask" wx:if="{{showNotes}}" bindtap="closeNotesSheet"></view>
  <view class="marks-sheet" wx:if="{{showNotes}}">
    <view class="sheet-title">全部笔记（{{allNotes.length}}）</view>
    <scroll-view scroll-y class="sheet-list">
      <view class="marks-item" wx:for="{{allNotes}}" wx:key="idx">
        <view class="marks-src">《{{item.bookTitle}}》 {{item.text}}</view>
        <view class="marks-text">心得：{{item.note}}</view>
      </view>
      <view class="sheet-empty" wx:if="{{allNotes.length === 0}}">还没有笔记，去阅读页长按段落选「写笔记」</view>
    </scroll-view>
    <button class="btn-copy" bindtap="copyNotes" disabled="{{allNotes.length === 0}}">复制全部笔记</button>
  </view>

  <!-- 阅读报告 -->
  <view class="mask" wx:if="{{showReport}}" bindtap="closeReport"></view>
  <view class="report-overlay" wx:if="{{showReport}}" catchtap="noop">
    <view class="sheet-title" style="text-align:center">阅读报告</view>
    <image wx:if="{{reportImage}}" class="report-img" src="{{reportImage}}" mode="widthFix" />
    <view wx:else class="report-loading">生成中…</view>
    <view class="report-btns">
      <button class="rb save" bindtap="saveReport" disabled="{{!reportImage}}">保存到相册</button>
      <button class="rb close" bindtap="closeReport">关闭</button>
    </view>
  </view>
  <canvas type="2d" id="reportCanvas" class="report-canvas"></canvas>
</view>