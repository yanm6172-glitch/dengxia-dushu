.page {
  padding: 40rpx 36rpx 80rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.doc-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #3b3224;
  text-align: center;
}
.doc-meta {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #b3a488;
  text-align: center;
}
.doc-content {
  margin-top: 36rpx;
  font-size: 28rpx;
  line-height: 1.9;
  color: #5a4c35;
  white-space: pre-wrap;
}