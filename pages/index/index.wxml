<view class="page">
  <view class="hero">
    <view class="hero-title">灯下读书</view>
    <view class="hero-sub">每日 25 分钟古籍日课 · 已开卷 {{readCount}} 本</view>
  </view>

  <view class="day-strip">
    <text class="day-item">今日 {{todayMinutes}}/{{goalMinutes}} 分钟</text>
    <view class="goal-bar">
      <view class="goal-inner" style="width:{{goalPercent}}%"></view>
    </view>
    <text class="day-item" wx:if="{{goalDone}}">🎉</text>
    <text class="day-dot">·</text>
    <text class="day-item">连续 {{streak}} 天</text>
  </view>

  <view class="last-card" wx:if="{{lastBook}}" bindtap="continueLast">
    <view class="cover {{lastBook.color}}">{{lastBook.firstChar}}</view>
    <view class="last-info">
      <view class="last-title">接着读《{{lastBook.title}}》</view>
      <view class="last-sub">{{lastBook.author}} · 已读 {{lastBook.percent}}%</view>
      <view class="last-progress"><view class="last-progress-inner" style="width:{{lastBook.percent}}%"></view></view>
    </view>
    <button class="btn-read" catchtap="continueLast">继续读书</button>
  </view>

  <view class="plan-bar" bindtap="goPlan">
    <text class="plan-ico">📚</text>
    <text class="plan-text">大三读书计划 · 每月读什么一目了然</text>
    <text class="import-arrow">›</text>
  </view>

  <view class="import-bar" bindtap="goImport">
    <text class="import-plus">＋</text>
    <text class="import-text">导入自己的书籍（txt 文件 / 粘贴文本）</text>
    <text class="import-arrow">›</text>
  </view>

  <view class="search-box">
    <text class="search-icon">🔍</text>
    <input class="search-input" placeholder="搜索书名或作者" value="{{searchKey}}" bindinput="onSearch" />
  </view>

  <view class="quote-card" wx:if="{{quote}}">
    <view class="quote-text">「{{quote.text}}」</view>
    <view class="quote-src">——《{{quote.book}}》</view>
    <button class="btn-primary" bindtap="openQuoteBook">立即读书</button>
  </view>

  <view class="section" wx:for="{{grouped}}" wx:key="name" wx:for-item="group">
    <view class="section-title">{{group.name}}</view>
    <view class="book-card" hover-class="card-hover" wx:for="{{group.books}}" wx:key="id" data-id="{{item.id}}" bindlongpress="deleteBook">
      <view class="cover {{item.color}}">{{item.firstChar}}</view>
      <view class="book-main">
        <view class="book-title-line">
          <text class="book-title">{{item.title}}</text>
          <text class="tag" wx:if="{{item.custom}}">自藏</text>
        </view>
        <view class="book-author">{{item.author}}{{item.custom ? ' · ' + item.type : ''}}</view>
        <view class="progress" wx:if="{{item.started}}">
          <view class="progress-bar">
            <view class="progress-inner" style="width:{{item.percent}}%"></view>
          </view>
          <text class="progress-text">已读 {{item.percent}}%</text>
        </view>
      </view>
      <button class="btn-read" bindtap="openBook" data-id="{{item.id}}">{{item.started ? '继续读书' : '立即读书'}}</button>
    </view>
  </view>

  <view class="footer">书库为公版古籍 · 长按「自藏」书可删除</view>

  <!-- 新手引导 -->
  <view class="guide-overlay" wx:if="{{showGuide}}">
    <swiper class="guide-swiper" current="{{guideIndex}}" bindchange="guideChange" duration="300">
      <swiper-item>
        <view class="g-slide s1">
          <view class="g-logo">灯</view>
          <view class="g-title">灯下读书</view>
          <view class="g-sub">一盏灯 · 一卷书 · 一段静好的时光</view>
          <view class="g-desc">26 本公版古籍已内置\n点「立即读书」马上开读</view>
        </view>
      </swiper-item>
      <swiper-item>
        <view class="g-slide s2">
          <view class="g-ico">🎨</view>
          <view class="g-title">舒适的阅读器</view>
          <view class="g-desc">四套纸张主题 · 三种字体 · 行距缩进可调\n自动滚动 · 全文搜索 · 书摘卡一键分享</view>
        </view>
      </swiper-item>
      <swiper-item>
        <view class="g-slide s3">
          <view class="g-ico">🔥</view>
          <view class="g-title">坚持看得见</view>
          <view class="g-desc">每日目标 · 打卡热力图 · 阅读报告卡\n书签、笔记、摘抄，好句子都留得住</view>
        </view>
      </swiper-item>
      <swiper-item>
        <view class="g-slide s4">
          <view class="g-ico">📂</view>
          <view class="g-title">带上自己的书</view>
          <view class="g-desc">PDF / EPUB / TXT / Word 都能导入\n电脑直传 · 微信 QQ 文件 · 登录后云同步</view>
        </view>
      </swiper-item>
    </swiper>
    <view class="g-dots">
      <view class="g-dot {{guideIndex === 0 ? 'on' : ''}}"></view>
      <view class="g-dot {{guideIndex === 1 ? 'on' : ''}}"></view>
      <view class="g-dot {{guideIndex === 2 ? 'on' : ''}}"></view>
      <view class="g-dot {{guideIndex === 3 ? 'on' : ''}}"></view>
    </view>
    <view class="g-skip" bindtap="skipGuide">跳过</view>
    <view class="g-next" bindtap="nextGuide">{{guideIndex === 3 ? '开始读书' : '下一步'}}</view>
  </view>
</view>