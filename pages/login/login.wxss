.login-page {
  min-height: 100vh;
  background: #f3ead9;
  padding: 120rpx 60rpx 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}
.brand {
  text-align: center;
}
.logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8c5a3c, #a06a48);
  color: #fdf6e9;
  font-size: 60rpx;
  font-family: "Songti SC", "STSong", serif;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 28rpx;
  box-shadow: 0 8rpx 24rpx rgba(140, 90, 60, 0.3);
}
.name {
  font-size: 46rpx;
  font-weight: 700;
  letter-spacing: 8rpx;
  color: #3b3224;
}
.slogan {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8a7a5f;
  letter-spacing: 2rpx;
}
.desc {
  margin: 90rpx 0 30rpx;
  text-align: center;
  font-size: 26rpx;
  color: #6d5c42;
}
.btn-wx {
  background: #07c160;
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  padding: 18rpx 0;
  letter-spacing: 2rpx;
}
.agree-line {
  margin-top: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.checkbox {
  width: 34rpx;
  height: 34rpx;
  border: 2rpx solid #c9b28a;
  border-radius: 8rpx;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #ffffff;
  background: #fdfaf3;
}
.checkbox.on {
  background: #07c160;
  border-color: #07c160;
}
.agree-text {
  font-size: 22rpx;
  color: #9c8a6c;
}
.link {
  color: #576b95;
}
.guest {
  margin-top: 40rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8a7a5f;
}
.avatar-btn {
  width: 160rpx;
  height: 160rpx;
  padding: 0;
  margin: 30rpx auto;
  background: transparent;
  border-radius: 50%;
  line-height: 1;
}
.avatar-btn::after { border: none; }
.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-ph {
  background: #e8ddc8;
  color: #a06a48;
  font-size: 60rpx;
}
.nick-input {
  background: #fdfaf3;
  border-radius: 12rpx;
  padding: 20rpx 28rpx;
  font-size: 30rpx;
  text-align: center;
  margin-bottom: 30rpx;
}
.foot {
  margin-top: auto;
  text-align: center;
  font-size: 20rpx;
  color: #b3a488;
  padding-top: 60rpx;
}